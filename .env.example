# Secrets and machine-specific values. Copy to .env (git-ignored). Business settings live in squad.toml.

# Database (docker compose). Local development only: the port is bound to 127.0.0.1.
POSTGRES_PASSWORD=squad_dev
SQUAD_DSN=postgresql://squad:squad_dev@127.0.0.1:5433/squad                     # admin: human CLI, bot, coordinator
SQUAD_AGENT_DSN=postgresql://squad_agent:squad_agent_dev@127.0.0.1:5433/squad   # agents and runner (migrations/002)

# Telegram approvals bot (docs/telegram.md). Create a dedicated bot; only TELEGRAM_CHAT_ID can decide.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Builder (Claude Code). Empty = your Claude Code defaults.
BUILDER_MODEL=
CLAUDE_BIN=

# Optional
PEXELS_API_KEY=
FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=
