{
  "_note": "Claude Code tools for the builder (headless: anything not in 'allow' is denied; 'deny' always wins). The session runs inside sites/<slug> with a scrubbed environment. No interpreters, curl, cat or deploy CLIs: the runner deploys. pnpm build still runs the site's own code, so the OS sandbox ([builder] sandbox) is the real boundary. The runner records every denial in the ticket's run_note: calibrate on your first real runs.",
  "allow": [
    "Read",
    "Glob",
    "Grep",
    "Edit",
    "Write",
    "Skill",
    "WebSearch",
    "Bash(pnpm install:*)",
    "Bash(pnpm i:*)",
    "Bash(pnpm add:*)",
    "Bash(pnpm remove:*)",
    "Bash(pnpm create:*)",
    "Bash(pnpm build:*)",
    "Bash(pnpm run build:*)",
    "Bash(pnpm lint:*)",
    "Bash(pnpm run lint:*)",
    "Bash(git init:*)",
    "Bash(git status:*)",
    "Bash(git add:*)",
    "Bash(git commit:*)",
    "Bash(git diff:*)",
    "Bash(git log:*)",
    "Bash(git switch:*)",
    "Bash(git checkout:*)",
    "Bash(git branch:*)",
    "Bash(ls:*)",
    "Bash(mkdir:*)"
  ],
  "deny": [
    "Read(**/.env*)",
    "Edit(**/.env*)",
    "Write(**/.env*)",
    "Read(**/.ssh/**)",
    "Read(**/.aws/**)",
    "Read(**/.gnupg/**)",
    "Read(**/.credentials.json)",
    "Read(**/com.vercel.cli/**)",
    "Read(**/.codex/**)",
    "Read(**/squad.toml)",
    "Edit(**/.claude/**)",
    "Write(**/.claude/**)",
    "Edit(**/.git/**)",
    "Write(**/.git/**)",
    "Edit(**/.vercel/**)",
    "Write(**/.vercel/**)",
    "Edit(**/.npmrc)",
    "Write(**/.npmrc)",
    "WebFetch",
    "PowerShell",
    "Bash(git push:*)",
    "Bash(git remote:*)",
    "Bash(git config:*)",
    "Bash(git -c:*)",
    "Bash(git reset --hard:*)",
    "Bash(git clean:*)",
    "Bash(vercel:*)",
    "Bash(npx:*)",
    "Bash(pnpm dlx:*)",
    "Bash(pnpm exec:*)"
  ]
}
